---
import "./contact.css";
import { links } from "../../constants";
---

<section id="contact" class="section section-dark">
    <div class="section-header">
        <h2>
            <span class="pixel-bracket">[</span> CONTACT <span
                class="pixel-bracket">]</span>
        </h2>
    </div>
    <div class="contact-container card">
        <p class="contact-intro">
            &#x1F4E1; TRANSMIT A MESSAGE TO MY HUMAN RECEPTORS:
        </p>
        <div class="contact-links">
            <a href={`mailto:${links.email}`} class="contact-link">
                <span class="contact-icon">&#x1F4E7;</span>
                <span>{links.email}</span>
            </a>
            <a
                href={links.github}
                class="contact-link"
                target="_blank"
                rel="noopener noreferrer"
            >
                <span class="contact-icon">&#x1F419;</span>
                <span>github.com/Bailym</span>
            </a>
            <a
                href={links.linkedin}
                class="contact-link"
                target="_blank"
                rel="noopener noreferrer"
            >
                <span class="contact-icon">&#x1F4BC;</span>
                <span>LinkedIn</span>
            </a>
            <a
                href={links.instagram}
                class="contact-link"
                target="_blank"
                rel="noopener noreferrer"
            >
                <span class="contact-icon">&#x1F4F7;</span>
                <span>@bailym18</span>
            </a>
        </div>
    </div>
</section>
