---
import "./skills.css";

const skills = [
  "HTML/CSS + TypeScript + JavaScript", 
  "React + Node + Express",
  "Microservices",
  "Astro",
  "Cloud Based Services (AWS + Azure + GCP)", 
  "UI/UX Design",
  "MySQL + PostgreSQL", 
  "Low Level Programming in C/C++", 
  "Embedded Systems",
  "Microcontrollers", 
  "Hardware Design, Building and Testing",
  "BDD + TDD + Unit Testing",
  "Agile + Scrum",
  "And More!"
];

---
<section id="skills" class="section">
    <div class="section-header">
        <h2>
            <span class="pixel-bracket">[</span> SKILLS.json <span
                class="pixel-bracket">]</span>
        </h2>
    </div>
    <div class="skills-container">
        <div class="skills-code card">
            <p class="code-line"><span class="code-key">"skills"</span>: [</p>
            {
                skills.map((skill, i) => (
                    <p class="code-line code-indent">
                        <span class="code-string">"{skill}"</span>
                        {i < skills.length - 1 ? "," : ""}
                    </p>
                ))
            }
            <p class="code-line">]</p>
        </div>
        <div class="skills-bubbles">
            {skills.map((skill) => <span class="skill-bubble">{skill}</span>)}
        </div>
    </div>
</section>
