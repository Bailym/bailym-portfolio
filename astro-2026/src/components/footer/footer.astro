---
import "./footer.css";
import { name } from "../../constants";

const fakeVisitorCount = 13337 + Math.floor(Math.random() * 500);
---

<footer>
    <div class="footer-inner">
        <span class="footer-copy">&#x1F9A0; {name} &copy; {new Date().getFullYear()}</span>
        <span class="footer-visitors">VISITORS: {fakeVisitorCount}</span>
        <span class="footer-status">&#x1F7E2; ONLINE</span>
    </div>
</footer>
