---
import "./about.css";
import Winamp from "../winamp/winamp.astro";

const about = "Hello! My name is Baily. I'm a software developer based in Cornwall, England. I'm a graduate of the University of Plymouth. " +
"I mostly work with embedded systems, microservices, and full-stack web development, but I have experience with a variety of languages, " + 
"technologies, and frameworks. I'm always looking to learn new things! Im currently focusing on electronics, AI, and game development.";
---

<section id="about" class="section">
    <div class="section-header">
        <h2>
            <span class="pixel-bracket">[</span> ABOUT_ME.exe <span
                class="pixel-bracket">]</span>
        </h2>
    </div>
    <div class="about-grid">
        <div class="about-text card">
            <p class="body-text">{about}</p>
            <div class="stat-row">
                <span class="stat">&#x1F9A0; bugs fixed: ???</span>
                <span class="stat">&#x26A1; energy drinks: &infin;</span>
                <span class="stat">&#x1F480; sleep: null</span>
            </div>
        </div>
        <div class="about-decoration" aria-hidden="true">
            <Winamp />
        </div>
    </div>
</section>
