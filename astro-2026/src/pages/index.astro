---
const name = "YOUR NAME";
const role = "web developer / digital creature";
const about = "I write code, break things, and build stuff on the internet. Based somewhere with wifi. Open to work.";

const projects = [
  {
    title: "Project Alpha",
    description: "Some kind of app that does something cool. Replace this with a real description.",
    tech: ["React", "Node", "Postgres"],
    link: "#",
  },
  {
    title: "Project Beta",
    description: "Another project. Built it because I wanted to. It's pretty neat.",
    tech: ["Astro", "TypeScript", "CSS"],
    link: "#",
  },
  {
    title: "Project Gamma",
    description: "This one was hard. Learned a lot. Would probably do it differently now.",
    tech: ["Python", "FastAPI", "Redis"],
    link: "#",
  },
];

const skills = ["JavaScript", "TypeScript", "React", "Node.js", "Python", "CSS", "SQL", "Git"];

const links = {
  github: "https://github.com/yourusername",
  linkedin: "https://linkedin.com/in/yourusername",
  email: "you@email.com",
};
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <title>{name} — Portfolio</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Press+Start+2P&family=Share+Tech+Mono&display=swap" rel="stylesheet" />
  </head>
  <body>

    <!-- SLIME DRIP TOP -->
    <div class="slime-top" aria-hidden="true">
      {Array.from({length: 14}).map((_, i) => (
        <div class="drip" style={`--delay: ${(i * 0.3).toFixed(1)}s; --height: ${40 + Math.floor(i * 17 % 80)}px; --left: ${(i / 13 * 96 + 2).toFixed(1)}%`}></div>
      ))}
    </div>

    <!-- NAV -->
    <nav>
      <span class="nav-logo">&#x1F9A0; {name}</span>
      <ul>
        <li><a href="#about">ABOUT</a></li>
        <li><a href="#projects">PROJECTS</a></li>
        <li><a href="#skills">SKILLS</a></li>
        <li><a href="#contact">CONTACT</a></li>
      </ul>
    </nav>

    <!-- MARQUEE BANNER -->
    <div class="ticker-wrap" aria-hidden="true">
      <div class="ticker">
        <span>&#x1F9A0; WELCOME TO MY WEBSITE &#x1F9A0;</span>
        <span>&#x1F480; HIRE ME OR ELSE &#x1F480;</span>
        <span>&#x1F9EC; POWERED BY CAFFEINE AND SPITE &#x1F9EC;</span>
        <span>&#x1F47E; Y2K COMPLIANT &#x1F47E;</span>
        <span>&#x1F9A0; WELCOME TO MY WEBSITE &#x1F9A0;</span>
        <span>&#x1F480; HIRE ME OR ELSE &#x1F480;</span>
        <span>&#x1F9EC; POWERED BY CAFFEINE AND SPITE &#x1F9EC;</span>
        <span>&#x1F47E; Y2K COMPLIANT &#x1F47E;</span>
      </div>
    </div>

    <!-- HERO -->
    <section class="hero" id="top">
      <div class="hero-eyeball" aria-hidden="true">
        <svg viewBox="0 0 100 100" xmlns="http://www.w3.org/2000/svg">
          <circle cx="50" cy="50" r="48" fill="#f0f0d0" stroke="#39FF14" stroke-width="2"/>
          <circle cx="50" cy="50" r="22" fill="#1a0a2e"/>
          <circle cx="50" cy="50" r="14" fill="#000"/>
          <circle cx="60" cy="40" r="5" fill="white"/>
          <circle cx="42" cy="46" r="2" fill="white"/>
          <line x1="10" y1="30" x2="28" y2="48" stroke="#cc3333" stroke-width="1.2" opacity="0.7"/>
          <line x1="90" y1="25" x2="70" y2="47" stroke="#cc3333" stroke-width="1" opacity="0.6"/>
          <line x1="15" y1="70" x2="30" y2="55" stroke="#cc3333" stroke-width="1" opacity="0.5"/>
          <line x1="85" y1="72" x2="68" y2="55" stroke="#cc3333" stroke-width="1.2" opacity="0.7"/>
        </svg>
      </div>
      <div class="hero-content">
        <p class="hero-pre">&#x26A0; ENTERING THE ZONE &#x26A0;</p>
        <h1 class="hero-name glitch" data-text={name}>{name}<span class="blink">_</span></h1>
        <p class="hero-role">{role}</p>
        <div class="hero-buttons">
          <a href="#projects" class="btn btn-primary">VIEW WORK</a>
          <a href={`mailto:${links.email}`} class="btn btn-secondary">GET IN TOUCH</a>
        </div>
      </div>
    </section>

    <!-- ABOUT -->
    <section id="about" class="section">
      <div class="section-header">
        <h2><span class="pixel-bracket">[</span> ABOUT_ME.exe <span class="pixel-bracket">]</span></h2>
      </div>
      <div class="about-grid">
        <div class="about-text card">
          <p class="body-text">{about}</p>
          <p class="body-text">This site was built with Astro. It is probably cursed.</p>
          <div class="stat-row">
            <span class="stat">&#x1F9A0; bugs fixed: ???</span>
            <span class="stat">&#x2615; coffees: &infin;</span>
            <span class="stat">&#x1F480; sleep: null</span>
          </div>
        </div>
        <div class="about-decoration" aria-hidden="true">
          <div class="spinning-skull">&#x1F480;</div>
          <div class="decoration-text">LOADING<span class="dot-anim"></span></div>
          <div class="progress-bar-wrap">
            <div class="progress-bar"></div>
          </div>
          <div class="decoration-text small">100% THAT DEV</div>
        </div>
      </div>
    </section>

    <!-- PROJECTS -->
    <section id="projects" class="section section-dark">
      <div class="section-header">
        <h2><span class="pixel-bracket">[</span> PROJECTS <span class="pixel-bracket">]</span></h2>
      </div>
      <div class="projects-grid">
        {projects.map((project, i) => (
          <a href={project.link} class="project-card card" target="_blank" rel="noopener noreferrer">
            <div class="project-number">0{i + 1}</div>
            <h3 class="project-title">{project.title}</h3>
            <p class="project-desc">{project.description}</p>
            <div class="project-tech">
              {project.tech.map(t => <span class="tech-tag">{t}</span>)}
            </div>
            <span class="project-link-label">VIEW PROJECT &gt;&gt;</span>
            <div class="card-slime" aria-hidden="true"></div>
          </a>
        ))}
      </div>
    </section>

    <!-- SKILLS -->
    <section id="skills" class="section">
      <div class="section-header">
        <h2><span class="pixel-bracket">[</span> SKILLS.json <span class="pixel-bracket">]</span></h2>
      </div>
      <div class="skills-container">
        <div class="skills-code card">
          <p class="code-line"><span class="code-key">"skills"</span>: [</p>
          {skills.map((skill, i) => (
            <p class="code-line code-indent">
              <span class="code-string">"{skill}"</span>{i < skills.length - 1 ? ',' : ''}
            </p>
          ))}
          <p class="code-line">]</p>
        </div>
        <div class="skills-bubbles">
          {skills.map(skill => (
            <span class="skill-bubble">{skill}</span>
          ))}
        </div>
      </div>
    </section>

    <!-- CONTACT -->
    <section id="contact" class="section section-dark">
      <div class="section-header">
        <h2><span class="pixel-bracket">[</span> CONTACT <span class="pixel-bracket">]</span></h2>
      </div>
      <div class="contact-container card">
        <p class="contact-intro">&#x1F4E1; TRANSMIT A MESSAGE TO MY HUMAN RECEPTORS:</p>
        <div class="contact-links">
          <a href={`mailto:${links.email}`} class="contact-link">
            <span class="contact-icon">&#x1F4E7;</span>
            <span>{links.email}</span>
          </a>
          <a href={links.github} class="contact-link" target="_blank" rel="noopener noreferrer">
            <span class="contact-icon">&#x1F419;</span>
            <span>GitHub</span>
          </a>
          <a href={links.linkedin} class="contact-link" target="_blank" rel="noopener noreferrer">
            <span class="contact-icon">&#x1F4BC;</span>
            <span>LinkedIn</span>
          </a>
        </div>
      </div>
    </section>

    <!-- SLIME DRIP BOTTOM (inverted) -->
    <div class="slime-bottom" aria-hidden="true">
      {Array.from({length: 14}).map((_, i) => (
        <div class="drip" style={`--delay: ${(i * 0.25).toFixed(1)}s; --height: ${35 + Math.floor(i * 19 % 70)}px; --left: ${(i / 13 * 96 + 2).toFixed(1)}%`}></div>
      ))}
    </div>

    <!-- FOOTER -->
    <footer>
      <div class="footer-inner">
        <span class="footer-copy">&#x1F9A0; {name} &copy; {new Date().getFullYear()}</span>
        <span class="footer-visitors">VISITORS: <span id="vc">00000</span></span>
        <span class="footer-status">&#x1F7E2; ONLINE</span>
      </div>
    </footer>

    <!-- CURSOR TRAIL -->
    <canvas id="slime-canvas" aria-hidden="true"></canvas>

  </body>
</html>

<style is:global>
  *, *::before, *::after {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  :root {
    --slime:    #39FF14;
    --slime-dk: #1a7a00;
    --pus:      #c8b400;
    --hot-pink: #ff00cc;
    --chrome:   #c0c0c0;
    --dark:     #080f06;
    --dark2:    #0f1a0c;
    --text:     #c8e6c9;
    --text-dim: #7a9c6a;
    --glow:     0 0 8px #39FF14, 0 0 22px #1a7a00;
    --font-pixel: 'Press Start 2P', monospace;
    --font-mono:  'Share Tech Mono', monospace;
  }

  html { scroll-behavior: smooth; }

  body {
    background-color: var(--dark);
    color: var(--text);
    font-family: var(--font-mono);
    font-size: 16px;
    line-height: 1.7;
    cursor: crosshair;
    overflow-x: hidden;
  }

  /* CRT scanline overlay */
  body::after {
    content: '';
    position: fixed;
    inset: 0;
    background: repeating-linear-gradient(
      to bottom,
      transparent 0px,
      transparent 3px,
      rgba(0, 0, 0, 0.07) 3px,
      rgba(0, 0, 0, 0.07) 4px
    );
    pointer-events: none;
    z-index: 9999;
  }

  /* ── SLIME DRIPS ── */
  .slime-top {
    position: relative;
    height: 60px;
    background: var(--slime);
    width: 100%;
    z-index: 10;
  }
  .slime-bottom {
    position: relative;
    height: 60px;
    background: var(--slime);
    width: 100%;
    z-index: 10;
    transform: scaleY(-1);
  }
  .drip {
    position: absolute;
    left: var(--left);
    top: 100%;
    width: 14px;
    margin-left: -7px;
    height: var(--height);
    background: var(--slime);
    border-radius: 0 0 50% 50%;
    animation: drip-fall 3.5s ease-in var(--delay) infinite;
  }
  @keyframes drip-fall {
    0%   { height: 0;             opacity: 1; }
    55%  { height: var(--height); opacity: 1; }
    90%  { height: var(--height); opacity: 1; }
    100% { height: var(--height); opacity: 0; }
  }

  /* ── NAV ── */
  nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 14px 32px;
    background: rgba(0, 0, 0, 0.92);
    border-bottom: 2px solid var(--slime);
    position: sticky;
    top: 0;
    z-index: 100;
    backdrop-filter: blur(4px);
  }
  .nav-logo {
    font-family: var(--font-pixel);
    font-size: 0.55rem;
    color: var(--slime);
    text-shadow: var(--glow);
    white-space: nowrap;
  }
  nav ul {
    list-style: none;
    display: flex;
    gap: 24px;
  }
  nav ul a {
    font-family: var(--font-pixel);
    font-size: 0.5rem;
    color: var(--chrome);
    text-decoration: none;
    letter-spacing: 0.05em;
    transition: color 0.2s, text-shadow 0.2s;
  }
  nav ul a:hover {
    color: var(--slime);
    text-shadow: var(--glow);
  }

  /* ── TICKER ── */
  .ticker-wrap {
    background: var(--slime);
    overflow: hidden;
    padding: 6px 0;
    border-top: 2px solid var(--slime-dk);
    border-bottom: 2px solid var(--slime-dk);
  }
  .ticker {
    display: flex;
    width: max-content;
    animation: ticker-scroll 22s linear infinite;
  }
  .ticker span {
    font-family: var(--font-pixel);
    font-size: 0.45rem;
    color: var(--dark);
    padding: 0 40px;
    white-space: nowrap;
  }
  @keyframes ticker-scroll {
    from { transform: translateX(0); }
    to   { transform: translateX(-50%); }
  }

  /* ── HERO ── */
  .hero {
    min-height: 90vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 80px 32px;
    position: relative;
    background:
      radial-gradient(ellipse at 20% 50%, rgba(57, 255, 20, 0.07) 0%, transparent 60%),
      radial-gradient(ellipse at 80% 20%, rgba(255, 0, 204, 0.05) 0%, transparent 50%),
      var(--dark);
    overflow: hidden;
    text-align: center;
  }
  .hero-eyeball {
    position: absolute;
    top: 10%;
    right: 6%;
    width: 120px;
    opacity: 0.55;
    animation: eyeball-look 6s ease-in-out infinite;
  }
  @keyframes eyeball-look {
    0%, 100% { transform: translate(0, 0)    rotate(-5deg); }
    25%       { transform: translate(6px, -4px) rotate(3deg); }
    50%       { transform: translate(-4px, 6px) rotate(-2deg); }
    75%       { transform: translate(8px, 4px)  rotate(5deg); }
  }
  .hero-pre {
    font-family: var(--font-pixel);
    font-size: 0.45rem;
    color: var(--pus);
    letter-spacing: 0.15em;
    margin-bottom: 16px;
    animation: blink-text 1.4s step-end infinite;
  }
  .hero-name {
    font-family: var(--font-pixel);
    font-size: clamp(1rem, 3.5vw, 2.2rem);
    color: var(--slime);
    text-shadow: var(--glow);
    margin-bottom: 20px;
    line-height: 1.6;
    position: relative;
    display: inline-block;
  }
  /* Glitch */
  .glitch::before,
  .glitch::after {
    content: attr(data-text);
    position: absolute;
    inset: 0;
    font-family: var(--font-pixel);
    font-size: inherit;
    line-height: inherit;
    display: inline-block;
  }
  .glitch::before {
    color: var(--hot-pink);
    clip-path: polygon(0 30%, 100% 30%, 100% 50%, 0 50%);
    animation: glitch-a 4s steps(2) infinite;
  }
  .glitch::after {
    color: #00ffff;
    clip-path: polygon(0 62%, 100% 62%, 100% 74%, 0 74%);
    animation: glitch-b 3.2s steps(2) infinite;
  }
  @keyframes glitch-a {
    0%, 85%, 100% { transform: translateX(0); opacity: 0; }
    87% { transform: translateX(-4px); opacity: 0.8; }
    89% { transform: translateX( 4px); opacity: 0.8; }
    91% { transform: translateX( 0);   opacity: 0; }
  }
  @keyframes glitch-b {
    0%, 78%, 100% { transform: translateX(0); opacity: 0; }
    80% { transform: translateX( 3px); opacity: 0.7; }
    82% { transform: translateX(-3px); opacity: 0.7; }
    84% { transform: translateX( 0);   opacity: 0; }
  }
  .blink {
    animation: blink-text 0.8s step-end infinite;
    color: var(--slime);
  }
  @keyframes blink-text {
    0%, 100% { opacity: 1; }
    50%      { opacity: 0; }
  }
  .hero-role {
    font-size: 1rem;
    color: var(--text-dim);
    margin-bottom: 36px;
    letter-spacing: 0.08em;
  }
  .hero-buttons {
    display: flex;
    gap: 16px;
    justify-content: center;
    flex-wrap: wrap;
  }

  /* ── BUTTONS ── */
  .btn {
    font-family: var(--font-pixel);
    font-size: 0.5rem;
    padding: 14px 22px;
    text-decoration: none;
    letter-spacing: 0.1em;
    border: 2px solid;
    transition: all 0.15s;
    cursor: pointer;
    display: inline-block;
  }
  .btn-primary {
    background: var(--slime);
    color: var(--dark);
    border-color: var(--slime);
    box-shadow: 4px 4px 0 var(--slime-dk);
  }
  .btn-primary:hover {
    background: var(--dark);
    color: var(--slime);
    box-shadow: var(--glow);
    transform: translate(-2px, -2px);
  }
  .btn-secondary {
    background: transparent;
    color: var(--chrome);
    border-color: var(--chrome);
    box-shadow: 4px 4px 0 #333;
  }
  .btn-secondary:hover {
    color: var(--slime);
    border-color: var(--slime);
    box-shadow: var(--glow);
    transform: translate(-2px, -2px);
  }

  /* ── SECTIONS ── */
  .section {
    padding: 80px 32px;
    max-width: 1100px;
    margin: 0 auto;
  }
  .section-dark {
    max-width: 100%;
    background: var(--dark2);
    border-top: 1px solid var(--slime-dk);
    border-bottom: 1px solid var(--slime-dk);
    padding: 80px 32px;
  }
  .section-dark .section-header,
  .section-dark .projects-grid,
  .section-dark .contact-container {
    max-width: 1100px;
    margin-left: auto;
    margin-right: auto;
  }
  .section-header { margin-bottom: 48px; }
  .section-header h2 {
    font-family: var(--font-pixel);
    font-size: clamp(0.55rem, 1.8vw, 0.85rem);
    color: var(--slime);
    text-shadow: var(--glow);
    letter-spacing: 0.1em;
  }
  .pixel-bracket { color: var(--pus); }

  /* ── CARD ── */
  .card {
    background: rgba(57, 255, 20, 0.03);
    border: 1px solid var(--slime-dk);
    padding: 28px;
    position: relative;
    transition: border-color 0.2s, box-shadow 0.2s;
    overflow: hidden;
  }
  .card:hover {
    border-color: var(--slime);
    box-shadow: 0 0 20px rgba(57, 255, 20, 0.12);
  }

  /* ── ABOUT ── */
  .about-grid {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 32px;
    align-items: start;
  }
  .body-text {
    margin-bottom: 16px;
    font-size: 1rem;
  }
  .stat-row {
    display: flex;
    flex-wrap: wrap;
    gap: 20px;
    margin-top: 24px;
    padding-top: 20px;
    border-top: 1px solid var(--slime-dk);
  }
  .stat {
    font-family: var(--font-pixel);
    font-size: 0.38rem;
    color: var(--pus);
  }
  .about-decoration {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 14px;
    min-width: 150px;
    padding: 16px;
  }
  .spinning-skull {
    font-size: 3rem;
    display: inline-block;
    animation: spin-skull 5s linear infinite;
  }
  @keyframes spin-skull {
    from { transform: rotateY(0deg); }
    to   { transform: rotateY(360deg); }
  }
  .decoration-text {
    font-family: var(--font-pixel);
    font-size: 0.4rem;
    color: var(--slime);
    text-align: center;
    text-shadow: var(--glow);
    line-height: 1.9;
  }
  .decoration-text.small {
    color: var(--text-dim);
    font-size: 0.36rem;
    text-shadow: none;
  }
  .dot-anim::after {
    content: '';
    animation: dots 1.5s steps(4) infinite;
  }
  @keyframes dots {
    0%   { content: ''; }
    25%  { content: '.'; }
    50%  { content: '..'; }
    75%  { content: '...'; }
    100% { content: ''; }
  }
  .progress-bar-wrap {
    width: 110px;
    height: 8px;
    background: var(--dark);
    border: 1px solid var(--slime-dk);
    overflow: hidden;
  }
  .progress-bar {
    height: 100%;
    width: 0;
    background: linear-gradient(90deg, var(--slime-dk), var(--slime));
    animation: progress-fill 2.8s ease-in-out infinite;
  }
  @keyframes progress-fill {
    0%   { width: 0%;   opacity: 1; }
    75%  { width: 100%; opacity: 1; }
    100% { width: 100%; opacity: 0; }
  }

  /* ── PROJECTS ── */
  .projects-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 24px;
  }
  .project-card {
    text-decoration: none;
    color: var(--text);
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .card-slime {
    position: absolute;
    bottom: 0; left: 0; right: 0;
    height: 3px;
    background: linear-gradient(90deg, transparent, var(--slime), transparent);
    opacity: 0;
    transform: scaleX(0.3);
    transition: opacity 0.3s, transform 0.3s;
  }
  .project-card:hover .card-slime {
    opacity: 1;
    transform: scaleX(1);
  }
  .project-number {
    font-family: var(--font-pixel);
    font-size: 1.4rem;
    color: rgba(57, 255, 20, 0.18);
    line-height: 1;
  }
  .project-title {
    font-family: var(--font-pixel);
    font-size: 0.58rem;
    color: var(--slime);
    line-height: 1.8;
  }
  .project-desc {
    font-size: 0.9rem;
    color: var(--text-dim);
    flex: 1;
  }
  .project-tech {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .tech-tag {
    font-family: var(--font-pixel);
    font-size: 0.33rem;
    color: var(--dark);
    background: var(--slime-dk);
    padding: 4px 8px;
    border: 1px solid var(--slime);
  }
  .project-link-label {
    font-family: var(--font-pixel);
    font-size: 0.36rem;
    color: var(--hot-pink);
    letter-spacing: 0.1em;
    margin-top: 4px;
    transition: text-shadow 0.2s;
  }
  .project-card:hover .project-link-label {
    text-shadow: 0 0 8px var(--hot-pink);
  }

  /* ── SKILLS ── */
  .skills-container {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 32px;
    align-items: center;
  }
  .skills-code { font-family: var(--font-mono); }
