<script>
  // Fake visitor counter
  const vc = document.getElementById('vc');
  if (vc) {
    const count = 13337 + Math.floor(Math.random() * 500);
    vc.textContent = String(count).padStart(5, '0');
  }

  // Slime cursor trail
  const canvas = document.getElementById('slime-canvas') as HTMLCanvasElement | null;
  if (canvas) {
    const ctx = canvas.getContext('2d')!;
    let w = canvas.width  = window.innerWidth;
    let h = canvas.height = window.innerHeight;

    window.addEventListener('resize', () => {
      w = canvas.width  = window.innerWidth;
      h = canvas.height = window.innerHeight;
    });

    interface P { x: number; y: number; vx: number; vy: number; life: number; r: number; }
    const particles: P[] = [];

    window.addEventListener('mousemove', (e) => {
      for (let i = 0; i < 3; i++) {
        particles.push({
          x: e.clientX, y: e.clientY,
          vx: (Math.random() - 0.5) * 2,
          vy: Math.random() * 1.5 + 0.5,
          life: 1,
          r: Math.random() * 5 + 2,
        });
      }
    });

    (function loop() {
      ctx.clearRect(0, 0, w, h);
      for (let i = particles.length - 1; i >= 0; i--) {
        const p = particles[i];
        p.x  += p.vx;
        p.y  += p.vy;
        p.vy += 0.06;
        p.life -= 0.022;
        if (p.life <= 0) { particles.splice(i, 1); continue; }
        ctx.beginPath();
        ctx.arc(p.x, p.y, p.r * p.life, 0, Math.PI * 2);
        ctx.fillStyle = `rgba(57,255,20,${p.life * 0.45})`;
        ctx.fill();
      }
      requestAnimationFrame(loop);
    })();
  }
</script>
