---
import Navbar from "../components/navbar/navbar.astro";
import Marquee from "../components/marquee/marquee.astro";
import Hero from "../components/hero/hero.astro";
import About from "../components/about/about.astro";
import Skills from "../components/skills/skills.astro";
import Contact from "../components/contact/contact.astro";
import Footer from "../components/footer/footer.astro";
import { name } from "../constants";
import Projects from "../components/projects/projects.astro";
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <title>{name} — Portfolio</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Press+Start+2P&family=Share+Tech+Mono&display=swap" rel="stylesheet" />
  </head>
  <body>
    <div class="slime-top" aria-hidden="true"></div>

    <Navbar />
    <Marquee />
    <Hero />
    <About />
    <Projects />
    <Skills />
    <Contact />
    <Footer />

    <div class="slime-bottom" aria-hidden="true"></div>
  </body>
</html>

<style is:global>
  *, *::before, *::after {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  :root {
    --slime:    #39FF14;
    --slime-dk: #1a7a00;
    --pus:      #c8b400;
    --hot-pink: #ff00cc;
    --chrome:   #c0c0c0;
    --dark:     #080f06;
    --dark2:    #0f1a0c;
    --text:     #c8e6c9;
    --text-dim: #7a9c6a;
    --glow:     0 0 8px #39FF14, 0 0 22px #1a7a00;
    --font-pixel: 'Press Start 2P', monospace;
    --font-mono:  'Share Tech Mono', monospace;
  }

  html { scroll-behavior: smooth; }

  body {
    background-color: var(--dark);
    color: var(--text);
    font-family: var(--font-mono);
    font-size: 16px;
    line-height: 1.7;
    cursor: crosshair;
    overflow-x: hidden;
  }

  /* CRT scanline overlay */
  body::after {
    content: '';
    position: fixed;
    inset: 0;
    background: repeating-linear-gradient(
      to bottom,
      transparent 0px,
      transparent 3px,
      rgba(0, 0, 0, 0.07) 3px,
      rgba(0, 0, 0, 0.07) 4px
    );
    pointer-events: none;
    z-index: 9999;
  }

  .slime-bottom {
    position: relative;
    height: 20px;
    background: var(--slime);
    width: 100%;
    z-index: 10;
    transform: scaleY(-1);
  }


  /* ── BUTTONS ── */
  .btn {
    font-family: var(--font-pixel);
    font-size: 0.5rem;
    padding: 14px 22px;
    text-decoration: none;
    letter-spacing: 0.1em;
    border: 2px solid;
    transition: all 0.15s;
    cursor: pointer;
    display: inline-block;
  }
  .btn-primary {
    background: var(--slime);
    color: var(--dark);
    border-color: var(--slime);
    box-shadow: 4px 4px 0 var(--slime-dk);
  }
  .btn-primary:hover {
    background: var(--dark);
    color: var(--slime);
    box-shadow: var(--glow);
    transform: translate(-2px, -2px);
  }
  .btn-secondary {
    background: transparent;
    color: var(--chrome);
    border-color: var(--chrome);
    box-shadow: 4px 4px 0 #333;
  }
  .btn-secondary:hover {
    color: var(--slime);
    border-color: var(--slime);
    box-shadow: var(--glow);
    transform: translate(-2px, -2px);
  }

  /* ── SECTIONS ── */
  .section {
    padding: 80px 32px;
    max-width: 1100px;
    margin: 0 auto;
  }
  .section-dark {
    max-width: 100%;
    background: var(--dark2);
    border-top: 1px solid var(--slime-dk);
    border-bottom: 1px solid var(--slime-dk);
    padding: 80px 32px;
  }
  .section-dark .section-header,
  .section-dark .projects-grid,
  .section-dark .contact-container {
    max-width: 1100px;
    margin-left: auto;
    margin-right: auto;
  }
  .section-header { margin-bottom: 48px; }
  .section-header h2 {
    font-family: var(--font-pixel);
    font-size: clamp(0.55rem, 1.8vw, 0.85rem);
    color: var(--slime);
    text-shadow: var(--glow);
    letter-spacing: 0.1em;
  }
  .pixel-bracket { color: var(--pus); }

  /* ── CARD ── */
  .card {
    background: rgba(57, 255, 20, 0.03);
    border: 1px solid var(--slime-dk);
    padding: 28px;
    position: relative;
    transition: border-color 0.2s, box-shadow 0.2s;
    overflow: hidden;
  }
  .card:hover {
    border-color: var(--slime);
    box-shadow: 0 0 20px rgba(57, 255, 20, 0.12);
  }


  /* ── RESPONSIVE ── */
  @media (max-width: 768px) {
    .about-grid      { grid-template-columns: 1fr; }
    .skills-container { grid-template-columns: 1fr; }
    nav ul           { gap: 12px; }
  }
  @media (max-width: 480px) {
    nav ul           { display: none; }
    .section,
    .section-dark    { padding: 60px 20px; }
  }
</style>

<script>
  // Fake visitor counter
  const vc = document.getElementById('vc');
  if (vc) {
    const count = 13337 + Math.floor(Math.random() * 500);
    vc.textContent = String(count).padStart(5, '0');
  }
</script>
